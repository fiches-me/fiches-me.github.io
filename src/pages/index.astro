---
// Ici, on peut ajouter du code, des fichiers ou des variables que l'on pourra ensuite utiliser dans l'HTML

// On importe le composant Icon de astro-icon pour pouvoir l'utiliser dans notre HTML
import { Icon } from "astro-icon/components";
import "../assets/app.css";
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Fiches.me</title>
  </head>
  <body class="w-screen flex flex-col justify-center items-center">
    <img class="h-32 md:h-64 w-auto mt-8 md:mt-20" src="https://github.com/fiches-me.png" />
    <h1 class="font-bold text-4xl md:text-6xl my-2 md:my-8">FICHES.ME</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mx-2">
      <div class="card w-96 bg-base-200 card-lg border-3 border-base-300">
        <div class="card-body">
          <h2 class="card-title flex gap-2">
            <img src="https://cpes.fiches.me/logo.png" class="w-8 h-8"/>
            FICHES CPES
          </h2>
          <p>
            Fiches de mathématiques, informatique, économie et SVT du supérieur.
          </p>
          <div class="card-actions">
            <a class="w-full btn btn-error" href="https://cpes.fiches.me">Accéder au site</a>
          </div>
        </div>
      </div>
      <div class="card w-96 bg-base-200 card-lg border-3 border-base-300">
        <div class="card-body">
          <h2 class="card-title flex gap-2">
            <img src="https://kerna.fiches.me/logo.png" class="w-8 h-8"/>
            FICHES KERNANEC
          </h2>
          <p>
            Fiches de philosophie
          </p>
          <div class="card-actions">
            <a class="w-full btn btn-info" href="https://kerna.fiches.me">Accéder au site</a>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
